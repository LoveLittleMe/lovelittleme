<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Complete Your Order — Love Little Me</title>
<style>
  @import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;1,300;1,400&family=DM+Sans:wght@300;400;500&display=swap');

  :root {
    --bg:#FBF7EE;--bg-warm:#F5EDD8;--bg-card:#FEFAF3;
    --gold:#C9960C;--gold-light:#E3B84A;--gold-dim:#A87A0A;--gold-faint:#E8D5A0;
    --dark:#1C1408;--text:#2A1E08;--text-mid:#5C4A22;--text-dim:#8A7250;
    --cream-line:rgba(201,150,12,0.15);
  }

  *,*::before,*::after{box-sizing:border-box;margin:0;padding:0;}
  html{scroll-behavior:smooth;}
  body{background:var(--bg);color:var(--text);font-family:'DM Sans',sans-serif;font-weight:300;line-height:1.75;min-height:100vh;}

  body::before{content:'';position:fixed;inset:0;background-image:url("data:image/svg+xml,%3Csvg viewBox='0 0 512 512' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.65' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='1'/%3E%3C/svg%3E");opacity:0.025;pointer-events:none;z-index:500;}

  nav{position:fixed;top:0;left:0;right:0;z-index:100;display:flex;align-items:center;justify-content:space-between;padding:0 1.5rem;background:rgba(251,247,238,0.95);backdrop-filter:blur(12px);border-bottom:1px solid var(--cream-line);}
  .nav-logo{display:flex;align-items:center;text-decoration:none;}
  .nav-logo img{height:120px;width:auto;object-fit:contain;}
  .nav-back{font-size:0.72rem;letter-spacing:0.15em;text-transform:uppercase;color:var(--text-dim);text-decoration:none;transition:color 0.2s;}
  .nav-back:hover{color:var(--gold);}

  .page-wrap{max-width:640px;margin:0 auto;padding:10rem 1.5rem 6rem;}

  .page-eyebrow{font-size:0.65rem;letter-spacing:0.25em;text-transform:uppercase;color:var(--gold-dim);margin-bottom:1rem;opacity:0;animation:fadeUp 0.7s ease 0.1s forwards;}
  .page-title{font-family:'Cormorant Garamond',Georgia,serif;font-size:clamp(2rem,6vw,3.5rem);font-weight:300;color:var(--dark);line-height:1.1;margin-bottom:0.5rem;opacity:0;animation:fadeUp 0.8s ease 0.2s forwards;}
  .page-subtitle{font-family:'Cormorant Garamond',Georgia,serif;font-size:1.1rem;font-style:italic;color:var(--gold-dim);margin-bottom:3rem;opacity:0;animation:fadeUp 0.8s ease 0.35s forwards;}

  /* Order summary */
  .order-summary{background:var(--dark);border-radius:8px;padding:2rem;margin-bottom:2rem;position:relative;overflow:hidden;opacity:0;animation:fadeUp 0.8s ease 0.45s forwards;}
  .order-summary::before{content:'';position:absolute;top:0;left:0;right:0;height:2px;background:linear-gradient(to right,var(--gold),var(--gold-light),var(--gold));}

  .order-row{display:flex;align-items:center;justify-content:space-between;gap:1rem;}
  .order-left{}
  .order-wound{font-family:'Cormorant Garamond',Georgia,serif;font-size:1.1rem;color:#F5E4B0;margin-bottom:0.2rem;}
  .order-detail{font-size:0.78rem;color:#8A7250;}
  .order-price{font-family:'Cormorant Garamond',Georgia,serif;font-size:2.5rem;font-weight:300;color:var(--gold-light);line-height:1;}

  .order-divider{height:1px;background:rgba(245,228,176,0.08);margin:1.5rem 0;}

  .order-includes{display:grid;gap:0.5rem;}
  .order-include{display:flex;align-items:center;gap:0.6rem;font-size:0.8rem;color:#C4B48A;}
  .order-include::before{content:'—';color:var(--gold-dim);font-size:0.7rem;flex-shrink:0;}

  /* Photo preview */
  .photo-confirm{display:flex;align-items:center;gap:1.2rem;background:var(--bg-warm);border:1px solid var(--cream-line);border-radius:8px;padding:1.2rem 1.5rem;margin-bottom:2rem;opacity:0;animation:fadeUp 0.8s ease 0.5s forwards;}
  .photo-thumb{width:56px;height:56px;border-radius:50%;object-fit:cover;border:2px solid var(--gold);flex-shrink:0;}
  .photo-thumb-placeholder{width:56px;height:56px;border-radius:50%;border:2px dashed var(--gold-faint);flex-shrink:0;display:flex;align-items:center;justify-content:center;font-size:0.65rem;color:var(--text-dim);text-align:center;letter-spacing:0.05em;}
  .photo-info{}
  .photo-label{font-size:0.72rem;letter-spacing:0.15em;text-transform:uppercase;color:var(--gold-dim);margin-bottom:0.2rem;}
  .photo-status{font-size:0.88rem;color:var(--text-mid);}
  .photo-change{font-size:0.72rem;color:var(--gold-dim);text-decoration:underline;cursor:pointer;display:block;margin-top:0.2rem;}

  /* Payment form */
  .payment-form{opacity:0;animation:fadeUp 0.8s ease 0.6s forwards;}

  .form-section-label{font-size:0.62rem;letter-spacing:0.22em;text-transform:uppercase;color:var(--gold-dim);margin-bottom:1rem;}

  .field-group{margin-bottom:1.2rem;}
  .field-label{font-size:0.75rem;letter-spacing:0.1em;text-transform:uppercase;color:var(--text-dim);margin-bottom:0.4rem;display:block;}
  .field-input{width:100%;padding:0.9rem 1rem;background:var(--bg-card);border:1px solid var(--cream-line);border-radius:4px;font-family:'DM Sans',sans-serif;font-size:0.9rem;color:var(--text);transition:border-color 0.2s,box-shadow 0.2s;outline:none;}
  .field-input:focus{border-color:var(--gold);box-shadow:0 0 0 3px rgba(201,150,12,0.08);}
  .field-input::placeholder{color:var(--text-dim);}

  .field-row{display:grid;grid-template-columns:1fr 1fr;gap:1rem;}

  /* Stripe placeholder */
  .stripe-field{width:100%;padding:0.9rem 1rem;background:var(--bg-card);border:1px solid var(--cream-line);border-radius:4px;min-height:44px;display:flex;align-items:center;}
  .stripe-notice{font-size:0.8rem;color:var(--text-dim);font-style:italic;}

  .stripe-badge{display:flex;align-items:center;gap:0.5rem;margin:1rem 0 1.5rem;font-size:0.7rem;color:var(--text-dim);letter-spacing:0.08em;}

  /* Submit */
  .btn-submit{display:block;width:100%;background:var(--gold);color:var(--dark);border:none;font-family:'DM Sans',sans-serif;font-size:0.88rem;font-weight:500;letter-spacing:0.1em;text-transform:uppercase;padding:1.2rem 2rem;border-radius:4px;cursor:pointer;transition:all 0.3s ease;text-align:center;margin-bottom:1rem;}
  .btn-submit:hover{background:var(--gold-light);transform:translateY(-1px);box-shadow:0 8px 30px rgba(201,150,12,0.3);}

  .submit-note{font-size:0.72rem;color:var(--text-dim);text-align:center;line-height:1.6;}

  .ornament{display:flex;align-items:center;gap:0.8rem;margin:2.5rem auto;max-width:160px;}
  .ornament-line{flex:1;height:1px;background:linear-gradient(to right,transparent,var(--gold-faint));}
  .ornament-line:last-child{background:linear-gradient(to left,transparent,var(--gold-faint));}
  .ornament-dot{width:3px;height:3px;border-radius:50%;background:var(--gold);}

  footer{padding:2rem 1.5rem;text-align:center;border-top:1px solid var(--cream-line);background:var(--bg-warm);}
  .footer-tagline{font-family:'Cormorant Garamond',Georgia,serif;font-size:0.9rem;font-style:italic;color:var(--gold-dim);}

  @keyframes fadeUp{from{opacity:0;transform:translateY(18px);}to{opacity:1;transform:translateY(0);}}

  @media(min-width:768px){nav{padding:0 3rem;}.page-wrap{padding:10rem 3rem 6rem;}}
</style>
</head>
<body>

<nav>
  <a href="index.html" class="nav-logo"><img src="logo.jpg" alt="Love Little Me"></a>
  <a href="javascript:history.back()" class="nav-back">← Go back</a>
</nav>

<div class="page-wrap">

  <p class="page-eyebrow">Final Step</p>
  <h1 class="page-title">Complete your order</h1>
  <p class="page-subtitle" id="page-subtitle">Your healing video is almost ready.</p>

  <!-- Order summary -->
  <div class="order-summary">
    <div class="order-row">
      <div class="order-left">
        <p class="order-wound" id="order-wound-name">Healing Video</p>
        <p class="order-detail">Personalized animated video · One time</p>
      </div>
      <p class="order-price">$29</p>
    </div>
    <div class="order-divider"></div>
    <div class="order-includes">
      <p class="order-include">AI-generated personalized healing script</p>
      <p class="order-include">Ghibli-style animated video</p>
      <p class="order-include">Your chosen voice guide</p>
      <p class="order-include">Delivered to your email</p>
      <p class="order-include">Yours to keep forever</p>
    </div>
  </div>

  <!-- Photo confirmation -->
  <div class="photo-confirm">
    <div id="photo-thumb-container">
      <div class="photo-thumb-placeholder">Your photo</div>
    </div>
    <div class="photo-info">
      <p class="photo-label">Childhood photo</p>
      <p class="photo-status" id="photo-status">Ready for your video</p>
      <a href="javascript:history.back()" class="photo-change">Change photo</a>
    </div>
  </div>

  <!-- Payment form -->
  <div class="payment-form">

    <p class="form-section-label">Your email</p>
    <div class="field-group">
      <label class="field-label" for="email">Email address</label>
      <input class="field-input" type="email" id="email" placeholder="you@example.com" autocomplete="email">
    </div>

    <div class="ornament">
      <div class="ornament-line"></div>
      <div class="ornament-dot"></div>
      <div class="ornament-line"></div>
    </div>

    <p class="form-section-label">Payment details</p>

    <div class="field-group">
      <label class="field-label">Card number</label>
      <div class="stripe-field">
        <p class="stripe-notice">Stripe payment fields will load here once connected by your developer.</p>
      </div>
    </div>

    <div class="field-row">
      <div class="field-group">
        <label class="field-label">Expiry date</label>
        <div class="stripe-field"></div>
      </div>
      <div class="field-group">
        <label class="field-label">Security code</label>
        <div class="stripe-field"></div>
      </div>
    </div>

    <div class="stripe-badge">
      Secure payment powered by Stripe
    </div>

    <button class="btn-submit" id="submit-btn">Complete My Order — $29</button>
    <p class="submit-note">You will receive your personalized healing video by email. No subscription. No hidden fees. One payment, one video, yours forever.</p>

  </div>
</div>

<footer>
  <p class="footer-tagline">"Because you always deserved to be loved."</p>
</footer>

<script src="wounds-data.js"></script>
<script>
  var params = new URLSearchParams(window.location.search);
  var woundId = params.get('wound') || sessionStorage.getItem('selectedWound') || 'abandonment';
  var wound = getWoundById(woundId);

  if (wound) {
    document.title = wound.name + ' — Complete Your Order — Love Little Me';
    document.getElementById('order-wound-name').textContent = wound.name + ' Healing Video';
    document.getElementById('page-subtitle').textContent = 'Your ' + wound.name.toLowerCase() + ' healing video is almost ready.';
  }

  // Load photo preview if available
  var photoData = sessionStorage.getItem('photoData');
  if (photoData) {
    var img = document.createElement('img');
    img.src = photoData;
    img.alt = 'Your childhood photo';
    img.className = 'photo-thumb';
    document.getElementById('photo-thumb-container').innerHTML = '';
    document.getElementById('photo-thumb-container').appendChild(img);
    document.getElementById('photo-status').textContent = 'Uploaded and ready';
  }

  // Submit — will connect to Stripe when developer integrates
  document.getElementById('submit-btn').addEventListener('click', function() {
    var email = document.getElementById('email').value;
    if (!email || !email.includes('@')) {
      alert('Please enter a valid email address so we can deliver your video.');
      return;
    }
    sessionStorage.setItem('userEmail', email);
    // Stripe integration goes here
    alert('Payment integration coming soon. Your developer will connect Stripe here.');
  });
</script>

</body>
</html>
